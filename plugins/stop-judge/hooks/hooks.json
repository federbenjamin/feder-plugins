{
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${STOPSTOPPING_DIR:-$HOME/.claude/stopstopping}\"; test -f \"$D/DECISIONS.md\" && test ! -f \"$D/context-off\" && sed -E 's/ -- \"[^\"]{1,200}\"( \"[^\"]{1,200}\")? \\([0-9]{4}-[0-9]{2}-[0-9]{2}\\)$//' \"$D/DECISIONS.md\" || true"
          }
        ]
      }
    ]
  }
}
